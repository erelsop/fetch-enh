{
  "name": "fetch-enh",
"version": "1.0.0-rc.1",
  "description": "An enhanced fetch utility with built-in retry logic, authentication strategies, request/response interceptors, and intelligent error handling.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "build": "tsc && tsc -p tsconfig.esm.json",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/erelsop/FetchEnh.git"
  },
  "keywords": [
    "fetch",
    "http",
    "request",
    "enhanced",
    "typescript",
    "javascript"
  ],
  "author": "Ethan Elsop <ethanrelsop@gmail.com>",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/jest": "^29.5.6",
    "@types/node": "^16.11.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "jsdoc-to-markdown": "^8.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.4.5",
    "whatwg-fetch": "^3.6.20"
  }
}
