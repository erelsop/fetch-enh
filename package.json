{
  "name": "fetch-enh",
  "version": "1.0.0",
  "description": "An enhanced fetch utility with built-in retry logic, authentication strategies, request/response interceptors, and intelligent error handling.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "build": "tsc && tsc -p tsconfig.esm.json && node scripts/esm-fixup.mjs",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/esm-fixup.mjs",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/erelsop/fetch-enh.git"
  },
  "keywords": [
    "fetch",
    "http",
    "request",
    "enhanced",
    "typescript",
    "javascript",
    "retry",
    "interceptor",
    "authentication",
    "bearer",
    "oauth",
    "oauth2",
    "pagination",
    "abort",
    "abortcontroller",
    "sdk"
  ],
  "author": "Ethan Elsop <ethanrelsop@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.6",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.4.5",
    "undici": "^7.25.0",
    "whatwg-fetch": "^3.6.20"
  }
}
